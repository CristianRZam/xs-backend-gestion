# Local development configuration. This file is ignored by Git.
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://127.0.0.1:4200,http://192.168.1.216:8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xs_sistema
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

JWT_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==
JWT_EXPIRATION_MS=3600000

HIBERNATE_DDL_AUTO=update
SHOW_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

HIKARI_CONNECTION_TEST_QUERY=SELECT 1
HIKARI_MINIMUM_IDLE=1
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_IDLE_TIMEOUT_MS=30000
HIKARI_POOL_NAME=HikariPool

SPRING_PROFILES_ACTIVE=local
UPLOAD_DIR=C:/sistema-gestion/
BACKEND_URL=http://localhost:8080
FILES_PUBLIC_BASE_URL=http://localhost:8080/api/files
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=100MB

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

OPERATIONAL_CHECK_INTERVAL_MS=900000
NOTIFICATIONS_VISIBLE_DAYS=7
OPERATIONAL_CHECK_INITIAL_DELAY_MS=30000
LOW_STOCK_THRESHOLD=0
NO_MOVEMENT_DAYS=30
OPEN_CASH_HOURS=24
PENDING_COUNT_HOURS=24
